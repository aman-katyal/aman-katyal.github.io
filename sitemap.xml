---
layout: null
sitemap: false
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
{%- for p in site.pages -%}
  {%- assign ext = p.path | split: '.' | last -%}
  {%- if p.url and ext != 'xml' and ext != 'txt' and ext != 'scss' and p.url != '/404.html' and p.sitemap != false -%}
  <url>
    <loc>{{ p.url | absolute_url }}</loc>
  </url>
  {%- endif -%}
{%- endfor -%}
</urlset>
